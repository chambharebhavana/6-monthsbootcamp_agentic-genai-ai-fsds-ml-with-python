import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from xgboost import XGBClassifier # 1. Import XGBoost
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import confusion_matrix, accuracy_score, classification_report

# Load dataset
dataset = pd.read_csv(r"D:\Data Science & Ai Assigned work\Social_Network_Ads.csv")

X = dataset.iloc[:, [2, 3]].values
y = dataset.iloc[:, -1].values

# Split dataset
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, random_state=0)

# Feature Scaling (Important for some models, optional but good practice for XGBoost)
sc = StandardScaler()
X_train = sc.fit_transform(X_train)
X_test = sc.transform(X_test)

# 2. Change Classifier to XGBoost
classifier = XGBClassifier(n_estimators=100, learning_rate=0.1, max_depth=3, random_state=0)
classifier.fit(X_train, y_train)

# Predict
y_pred = classifier.predict(X_test)

# Evaluate
cm = confusion_matrix(y_test, y_pred)
print("Confusion Matrix:")
print(cm)

ac = accuracy_score(y_test, y_pred)
print(f"Test Accuracy: {ac}")

cr = classification_report(y_test, y_pred)
print("Classification Report:")
print(cr)

# Bias and Variance
bias = classifier.score(X_train, y_train)
print(f"Training Score (Bias): {bias}")

variance = classifier.score(X_test, y_test)
print(f"Testing Score (Variance): {variance}")